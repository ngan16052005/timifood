# =============================================
# TiMiFood - Cấu hình Biến Môi trường (.env)
# =============================================
# Sao chép file này thành `.env` và điền thông tin phù hợp.

# --- Database (SQL Server) ---
DB_USER=sa
DB_PASSWORD=your_database_password
DB_SERVER=localhost
DB_DATABASE=TiMiFoodDB
DB_PORT=1433

# --- Server ---
PORT=3500

# --- JWT Secret Key (Khóa bí mật để mã hóa token) ---
JWT_SECRET=TiMiFood_Secret_Key_2026

# --- CORS (Danh sách domain được phép truy cập, dùng dấu phẩy nếu nhiều domain) ---
# Để * cho development, đặt domain cụ thể cho production
# Ví dụ: CORS_ORIGIN=https://timifood.com,https://admin.timifood.com
CORS_ORIGIN=*

# --- Nodemailer (Gửi Email) ---
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your_app_password
MAIL_FROM="TiMi Food <your-email@gmail.com>"

# --- PayOS Integration (Cổng thanh toán) ---
# Để trống = chế độ mô phỏng (Simulation mode)
# Đăng ký tại: https://payos.vn
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Cấu hình Google OAuth2 (Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# --- Google Gemini AI (Chatbot) ---
GEMINI_API_KEY=

# --- Web Push Notifications (VAPID Keys) ---
# Generate using: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@gmail.com
