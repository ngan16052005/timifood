    <div class="modal signup">
        <div class="modal-container">
            <h3 class="modal-container-title add-account-e">THÊM KHÁCH HÀNG MỚI</h3>
            <h3 class="modal-container-title edit-account-e">CHỈNH SỬA THÔNG TIN</h3>
            <button class="modal-close"><i class="fa-regular fa-xmark"></i></button>
            <div class="form-content sign-up">
                <form action="" class="signup-form">
                    <div class="form-group">
                        <label for="fullname" class="form-label">Tên đầy đủ</label>
                        <input id="fullname" name="fullname" type="text" autocomplete="name" placeholder="VD: Nhật Sinh"
                            class="form-control">
                        <span class="form-message-name form-message"></span>
                    </div>
                    <div class="form-group">
                        <label for="user-role" class="form-label">Quyền hạn</label>
                        <select id="user-role" class="form-control">
                            <option value="0">Khách hàng</option>
                            <option value="2">Nhân viên</option>
                            <option value="1">Quản trị viên</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="user-email" class="form-label">Email</label>
                        <input id="user-email" name="user-email" type="email" autocomplete="email" placeholder="Nhập địa chỉ email"
                            class="form-control">
                        <span class="form-message-email form-message"></span>
                    </div>
                    <div class="form-group">
                        <label for="phone" class="form-label">Số điện thoại</label>
                        <input id="phone" name="phone" type="text" autocomplete="tel" placeholder="Nhập số điện thoại"
                            class="form-control">
                        <span class="form-message-phone form-message"></span>
                    </div>
                    <div class="form-group">
                        <label for="password" class="form-label">Mật khẩu</label>
                        <input id="password" name="password" type="text" autocomplete="new-password" placeholder="Nhập mật khẩu"
                            class="form-control">
                        <small class="form-text text-muted" style="font-size: 0.8rem; color: #666;">Tối thiểu 8 ký tự, gồm chữ hoa, chữ thường và số</small>
                        <span class="form-message-password form-message"></span>
                    </div>
                    <div class="form-group edit-account-e">
                        <label for="user-status" class="form-label">Trạng thái</label>
                        <input type="checkbox" id="user-status" class="switch-input">
                        <label for="user-status" class="switch"></label>
                    </div>
                    <button class="form-submit add-account-e" id="signup-button">Đăng ký</button>
                    <button class="form-submit edit-account-e" id="btn-update-account"><i
                            class="fa-regular fa-floppy-disk"></i> Lưu thông tin</button>
                </form>
            </div>
        </div>
    </div>
    </div>
    <div class="modal voucher">
        <div class="modal-container">
            <h3 class="modal-container-title">TẠO MÃ GIẢM GIÁ MỚI</h3>
            <button class="modal-close" onclick="closeVoucherModal()"><i class="fa-regular fa-xmark"></i></button>
            <div class="form-content">
                <form action="" class="voucher-form">
                    <div class="form-group">
                        <label for="v-code" class="form-label">Mã giảm giá</label>
                        <input id="v-code" type="text" placeholder="VD: GIAM20K" class="form-control">
                    </div>
                    <div class="form-group">
                        <label for="v-value" class="form-label">Giá trị giảm</label>
                        <input id="v-value" type="number" placeholder="Số lượng" class="form-control">
                    </div>
                    <div class="form-group">
                        <label for="v-type" class="form-label">Loại giảm giá</label>
                        <select id="v-type" class="form-control">
                            <option value="0">Phần trăm (%)</option>
                            <option value="1">Số tiền (VND)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="v-min" class="form-label">Đơn tối thiểu</label>
                        <input id="v-min" type="number" placeholder="VD: 100000" class="form-control">
                    </div>
                    <div class="form-group">
                        <label for="v-max" class="form-label">Giảm tối đa (cho %)</label>
                        <input id="v-max" type="number" placeholder="VD: 50000" class="form-control">
                    </div>
                    <div class="form-group">
                        <label for="v-expiry" class="form-label">Ngày hết hạn</label>
                        <input id="v-expiry" type="date" class="form-control">
                    </div>
                    <button type="button" class="form-submit" onclick="saveVoucher()"><i
                            class="fa-regular fa-floppy-disk"></i> Lưu mã</button>
                </form>
            </div>
        </div>
