    <!-- Chat History Modal -->
    <div class="modal chat-history-modal">
        <div class="modal-container" style="max-width: 900px; width: 90%;">
            <h3 class="modal-container-title">LỊCH SỬ HỖ TRỢ TRỰC TUYẾN</h3>
            <button class="modal-close" onclick="closeChatHistoryModal()"><i class="fa-regular fa-xmark"></i></button>
            <div class="modal-content" style="padding: 20px;">
                <div class="admin-control" style="margin-bottom: 15px;">
                    <div class="admin-control-center" style="display: flex; gap: 10px;">
                        <input type="text" id="chat-history-phone" class="form-search-input" placeholder="Tìm theo SĐT Khách hàng" style="flex: 1;">
                        <input type="date" id="chat-history-date" class="form-search-input" style="flex: 1;">
                        <button class="btn-control-large" onclick="loadChatHistory()"><i class="fa-light fa-filter"></i> Lọc</button>
                    </div>
                </div>
                
                <div class="table" style="max-height: 400px; overflow-y: auto;">
                    <table width="100%">
                        <thead>
                            <tr>
                                <td>ID</td>
                                <td>Thời gian</td>
                                <td>Khách hàng</td>
                                <td>Nhân viên</td>
                                <td>Trạng thái</td>
                                <td>Thao tác</td>
                            </tr>
                        </thead>
                        <tbody id="chat-history-list">
                            <!-- Injected by JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Chat Messages View Modal -->
    <div class="modal chat-messages-modal">
        <div class="modal-container" style="width: 90%; max-width: 600px;">
            <h3 class="modal-container-title" style="margin-right: 40px; margin-bottom: 0;">NỘI DUNG TRÒ CHUYỆN</h3>
            <button class="modal-close" onclick="closeChatMessagesModal()"><i class="fa-regular fa-xmark"></i></button>
            <div class="modal-content" style="padding: 20px;">
                <div class="chat-window-messages" id="chat-history-messages-content" style="height: 500px; border: 1px solid #eee; border-radius: 8px; overflow-y: auto;">
                    <!-- Messages flow dynamically -->
                </div>
            </div>
        </div>
    </div>
    <!-- News Add/Edit Modal -->
    <div class="modal add-news-modal">
        <div class="modal-container" style="width: 800px; padding-bottom: 20px;">
            <h3 class="modal-container-title add-news-e">THÊM TIN TỨC MỚI</h3>
            <h3 class="modal-container-title edit-news-e" style="display: none;">CHỈNH SỬA TIN TỨC</h3>
            <button class="modal-close" onclick="closeNewsModal()"><i class="fa-regular fa-xmark"></i></button>
            <div class="modal-content">
                <form action="" class="add-news-form add-product-form" id="news-form" onsubmit="submitNews(event)">
                    <div class="modal-content-left">
                        <img src="./assets/img/blank-image.png" alt="" class="upload-image-preview" id="news-img-preview">
                        <div class="form-group file">
                            <label for="up-news-img" class="form-label-file"><i
                                    class="fa-regular fa-cloud-arrow-up"></i>Chọn hình ảnh thu nhỏ</label>
                            <input accept="image/jpeg, image/png, image/jpg" id="up-news-img" name="up-news-img"
                                type="file" class="form-control" onchange="uploadNewsImage(this)">
                        </div>
                    </div>
                    <div class="modal-content-right">
                        <input type="hidden" id="news-id">
                        <input type="hidden" id="news-img-url">
                        <div class="form-group">
                            <label for="news-title" class="form-label">Tiêu đề bài viết</label>
                            <input id="news-title" name="news-title" type="text" placeholder="Nhập tiêu đề..."
                                class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label for="news-author" class="form-label">Tác giả</label>
                            <input id="news-author" name="news-author" type="text" placeholder="Tên tác giả..."
                                class="form-control" value="Admin" required>
                        </div>
                        <div class="form-group">
                            <label for="news-status" class="form-label">Trạng thái</label>
                            <select id="news-status" name="news-status" class="form-control">
                                <option value="1">Hiển thị (Active)</option>
                                <option value="0">Ẩn (Hidden)</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="news-content" class="form-label">Nội dung</label>
                            <textarea id="news-content" class="product-desc" style="height: 150px;" placeholder="Nhập nội dung bài viết... (hỗ trợ HTML cơ bản)" required></textarea>
                        </div>
                        <button type="submit" class="form-submit add-news-e">
                            <i class="fa-regular fa-plus"></i>
                            <span>THÊM BÀI VIẾT</span>
                        </button>
                        <button type="button" class="form-submit edit-news-e" style="display: none;" onclick="updateNews()">
                            <i class="fa-light fa-pencil"></i>
                            <span>LƯU THAY ĐỔI</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
